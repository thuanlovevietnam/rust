{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfs.dev/schemas/v1/capability-schema.json",
  "title": "PFS Capability Specification Schema",
  "description": "Formal schema for PFS Capability Catalog and Capability Profiles",
  "type": "object",
  "required": ["capability_id", "name", "category", "version", "provider_type", "lifecycle_state"],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^cap\\.[a-z0-9_.-]+$",
      "description": "Stable canonical URN identifier for the capability"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["Governance", "Domain", "Architecture", "Quality", "Security", "Operations", "Extension"]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "SemVer 2.0.0 version string"
    },
    "provider_type": {
      "type": "string",
      "enum": ["CoreProvided", "ExtensionProvided"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflicts_with": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "path_pattern"],
        "properties": {
          "artifact_type": { "type": "string" },
          "path_pattern": { "type": "string" },
          "mandatory": { "type": "boolean", "default": true }
        }
      }
    },
    "validation_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quality_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["Draft", "Active", "Deprecated", "Retired"]
    }
  },
  "additionalProperties": false
}
