{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfs.dev/schemas/v1/artifact-schema.json",
  "title": "PFS Artifact Entity Schema",
  "description": "Formal schema for PFS Artifact metadata and provenance",
  "type": "object",
  "required": ["artifact_id", "project_id", "name", "path_uri", "artifact_type", "format", "content_hash", "lifecycle_state", "classification", "created_at"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path_uri": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string",
      "enum": ["Specification", "ArchitectureDesign", "SourceCode", "Configuration", "Schema", "DecisionRecord", "EvidenceReport", "BinaryBlob"]
    },
    "format": {
      "type": "string",
      "enum": ["Markdown", "JSON", "YAML", "Mermaid", "RustSource", "Binary"]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of content"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["Draft", "InReview", "Approved", "Active", "Superseded", "Archived"]
    },
    "classification": {
      "type": "string",
      "enum": ["Public", "Internal", "Confidential", "Restricted"]
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_from": {
      "type": "array",
      "items": { "type": "string" }
    },
    "implements_reqs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "governed_by": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
