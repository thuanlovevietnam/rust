{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfs.dev/schemas/v1/intent-schema.json",
  "title": "PFS Project Intent Metamodel Schema",
  "description": "Formal schema for PFS Project Intent aggregate, intake parsing, and structured goals",
  "type": "object",
  "required": [
    "intent_id",
    "project_id",
    "raw_input",
    "structured_goals",
    "domain_hint",
    "classification",
    "lifecycle_status",
    "created_at"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Canonical ULID identifier for the Intent"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID identifier of the associated Project aggregate"
    },
    "source_type": {
      "type": "string",
      "enum": ["CLI_Prompt", "DocumentUpload", "InterviewDialog", "API_Payload", "ImportedSpec"],
      "default": "CLI_Prompt",
      "description": "Intake channel through which the intent was submitted"
    },
    "raw_input": {
      "type": "string",
      "minLength": 10,
      "maxLength": 65536,
      "description": "Verbatim raw text or unstructured brief provided by stakeholder"
    },
    "structured_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["goal_id", "statement", "priority"],
        "properties": {
          "goal_id": {
            "type": "string",
            "pattern": "^GOAL-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "priority": {
            "type": "string",
            "enum": ["P0_Critical", "P1_High", "P2_Medium", "P3_Low"]
          },
          "target_metric": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Decomposed structured objectives derived from raw intent"
    },
    "domain_hint": {
      "type": "string",
      "enum": [
        "SoftwareProduct",
        "BusinessStrategy",
        "AcademicResearch",
        "SmartCityIoT",
        "OperationsGovernance",
        "CustomDomain"
      ],
      "description": "Target domain profile identified for capability and metamodel mapping"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "technology_stack": {
          "type": "array",
          "items": { "type": "string" }
        },
        "budget_limit_usd": {
          "type": "number",
          "minimum": 0
        },
        "target_deadline": {
          "type": "string",
          "format": "date"
        },
        "regulatory_frameworks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target_audience": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "description": "Explicit constraints imposed on foundation execution"
    },
    "stakeholders": {
      "type": "object",
      "required": ["primary_owner"],
      "properties": {
        "primary_owner": {
          "type": "string",
          "description": "Principal ID or name of the project sponsor"
        },
        "designated_reviewers": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "string",
      "enum": ["Public", "Internal", "Confidential", "Restricted"],
      "default": "Internal",
      "description": "Data classification tier governed by INV-11 and PEP/PDP enforcement"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["Draft", "Parsed", "ClarificationRequired", "Validated", "BoundToProject", "Superseded"],
      "default": "Draft",
      "description": "Lifecycle state of the Intent"
    },
    "provenance": {
      "type": "object",
      "required": ["submitted_by", "intake_timestamp"],
      "properties": {
        "submitted_by": { "type": "string" },
        "intake_timestamp": { "type": "string", "format": "date-time" },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
